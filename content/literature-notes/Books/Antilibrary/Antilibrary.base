properties:
  author:
    displayName: Author
  type:
    displayName: Type
  genre:
    displayName: Genre
  pages:
    displayName: Pages
  status:
    displayName: Status
  cover:
    displayName: Cover
  link:
    displayName: Amazon
views:
  - type: table
    name: All Books
    filters:
      and:
        - file.inFolder("literature-notes/Books/Antilibrary")
        - file.ext == "md"
        - file.name != "000 Antilibrary"
    order:
      - file.name
      - author
      - type
      - genre
      - pages
    sort: []
    columnSize:
      file.name: 503
      note.genre: 159
  - type: table
    name: Fiction
    filters:
      and:
        - file.inFolder("literature-notes/Books/Antilibrary")
        - file.ext == "md"
        - file.name != "000 Antilibrary"
        - type == "Fiction"
    order:
      - file.name
      - author
      - genre
      - pages
      - status
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Non-Fiction
    filters:
      and:
        - file.inFolder("literature-notes/Books/Antilibrary")
        - file.ext == "md"
        - file.name != "000 Antilibrary"
        - type == "Non-Fiction"
    order:
      - file.name
      - author
      - genre
      - pages
      - status
    sort:
      - property: file.name
        direction: ASC
  - type: cards
    name: Gallery
    filters:
      and:
        - file.inFolder("literature-notes/Books/Antilibrary")
        - file.ext == "md"
        - file.name != "000 Antilibrary"
    order:
      - file.name
      - author
      - type
      - genre
    sort:
      - property: file.name
        direction: ASC
    image: note.cover
    imageFit: contain
